{
    "dntest": {
        "command": "/opt/homebrew/bin/npx",
        "args": [
            "-y",
            "mcp-remote",
            "https://dntest.decisionnext.com:8001/mcp",
            "--header",
            "Authorization:${AUTH_HEADER}"
        ],
        "env": {
            "AUTH_HEADER": "Bearer <TOKEN>"
        }
    }
}
